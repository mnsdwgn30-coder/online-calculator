---
// Conversion-focused Hero Section Component
---

<header class="hero-section">
  <div class="hero-badge">
    <span class="pulse-dot"></span>
    <span data-i18n="hero_badge">Free & Private Online Math Suite • Version 7.3</span>
  </div>

  <h1 class="hero-main-title" data-i18n="hero_title">
    Fast, Free & Private Online Calculator
  </h1>

  <p class="hero-description" data-i18n="hero_subtitle">
    Perform instant standard & scientific arithmetic, retail discounts, unit conversions, health metrics, and finance calculations — powered by client-side precision and zero tracking.
  </p>

  <!-- Value Proof Pills -->
  <div class="hero-proof-pills">
    <div class="proof-pill">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span data-i18n="hero_pill_privacy">100% Free & No Signup</span>
    </div>
    <div class="proof-pill">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
      <span data-i18n="hero_pill_fast">Instant Zero Latency</span>
    </div>
    <div class="proof-pill">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      <span data-i18n="hero_pill_offline">Offline Ready PWA</span>
    </div>
  </div>

  <!-- Quick Navigation CTAs -->
  <div class="hero-cta-group">
    <!-- Language Selector Dropdown in front of Launch Calculator -->
    <div class="lang-dropdown-wrapper">
      <button type="button" class="hero-cta-btn lang-hero-btn" id="btn-lang-toggle" title="Language / भाषा" data-i18n-title="switch_lang" aria-label="Select language">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span data-i18n="switch_lang">Language</span>
        <span class="lang-badge-pill" id="lang-current-code">EN</span>
      </button>

      <div class="lang-dropdown-menu hidden" id="lang-dropdown-menu">
        <div class="lang-dropdown-header">
          <span data-i18n="switch_lang">Select Language</span>
        </div>
        <div class="lang-options-grid" id="lang-options-grid">
          <!-- Dynamically populated by i18n.js -->
        </div>
      </div>
    </div>

    <a href="#calculator" class="hero-cta-btn primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="3"></rect><line x1="8" y1="6" x2="16" y2="6"></line></svg>
      <span data-i18n="hero_cta_calc">Launch Calculator</span>
    </a>
    <a href="#tools-section" class="hero-cta-btn secondary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
      <span data-i18n="hero_cta_tools">Quick Tools Hub</span>
    </a>
  </div>
</header>

<script>
  import '../scripts/i18n.js';
</script>
