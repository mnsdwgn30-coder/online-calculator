---
// Popular Tools Showcase Component
const popularTools = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>`,
    title: "Percentage Calculator",
    badge: "Popular",
    desc: "Calculate percentages of numbers, tax portions, and ratio calculations instantly in real-time.",
    target: "#tool-percentage",
    cta: "Calculate %"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>`,
    title: "Discount & GST Calculator",
    badge: "Finance",
    desc: "Find final shopping prices after percentage discounts, coupons, and GST/sales tax additions.",
    target: "#tool-discount",
    cta: "Calculate Price"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>`,
    title: "Universal Unit Converter",
    badge: "Standards",
    desc: "Convert metric & imperial measurements across Length, Mass/Weight, and Temperature scales.",
    target: "#tool-unit",
    cta: "Convert Units"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`,
    title: "BMI Health Calculator",
    badge: "Health",
    desc: "Assess body mass index score according to World Health Organization clinical standards.",
    target: "#tool-bmi",
    cta: "Check BMI"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg>`,
    title: "Exact Age Calculator",
    badge: "Utility",
    desc: "Find exact lived years, months, and days with automated leap-year date math and birthday timer.",
    target: "#tool-age",
    cta: "Calculate Age"
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="3"></rect><line x1="16" y1="14" x2="16" y2="14"></line><line x1="12" y1="14" x2="12" y2="14"></line><line x1="8" y1="14" x2="8" y2="14"></line></svg>`,
    title: "Scientific Calculator Suite",
    badge: "Advanced",
    desc: "Compute complex trigonometry (sin, cos, tan), natural logarithms (ln, log), and exponents (xʸ).",
    target: "#calculator",
    cta: "Launch Scientific"
  }
];
---

<section class="popular-tools-section" id="popular-tools">
  <div class="section-header">
    <div class="section-badge">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
      <span data-i18n="pop_tools_badge">Featured Calculation Suite</span>
    </div>
    <h2 class="section-title" data-i18n="pop_tools_title">Popular Tools & Specialized Calculators</h2>
    <p class="section-subtitle" data-i18n="pop_tools_subtitle">Instant, one-click access to our most widely used mathematical and commercial engines</p>
  </div>

  <div class="popular-grid">
    {popularTools.map((tool) => (
      <a href={tool.target} class="popular-tool-card" title={`Open ${tool.title}`}>
        <div class="pop-card-top">
          <div class="pop-icon-wrap" set:html={tool.icon} />
          <span class="pop-badge">{tool.badge}</span>
        </div>
        <h3 class="pop-title">{tool.title}</h3>
        <p class="pop-desc">{tool.desc}</p>
        <div class="pop-card-footer">
          <span class="pop-cta-text">{tool.cta} &rarr;</span>
        </div>
      </a>
    ))}
  </div>
</section>
