---
// Benefits & Value Proposition Section Component
const benefits = [
  {
    icon: "⚡",
    title: "Sub-Millisecond Execution",
    desc: "Evaluations run purely in your browser memory using optimized JavaScript engines. Zero network lag, zero latency."
  },
  {
    icon: "🔒",
    title: "100% Client-Side Privacy",
    desc: "Your numbers, calculations, and financial budgets never leave your computer or phone. No analytics tracking or ad-profiling."
  },
  {
    icon: "📴",
    title: "Full Offline PWA Capability",
    desc: "Add to your home screen or desktop. Works seamlessly during flights, commutes, or when internet connectivity is unavailable."
  },
  {
    icon: "⌨️",
    title: "Full Keyboard & Numpad Support",
    desc: "Engineered for speed. Use physical keyboard shortcuts (0-9, operators, Enter, Backspace, Esc) without touching your mouse."
  },
  {
    icon: "📜",
    title: "Calculation Tape History",
    desc: "Automatically logs your recent operations with 1-click memory recall to restore previous values into your active display."
  },
  {
    icon: "🌙",
    title: "Glassmorphic Dark & Light Modes",
    desc: "Carefully calibrated high-contrast color palettes for daytime clarity and late-night eye comfort with synthesized tactile audio."
  }
];
---

<section class="benefits-section" id="benefits">
  <div class="section-header">
    <div class="section-badge">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
      </svg>
      <span data-i18n="benefits_badge">Key Advantages</span>
    </div>
    <h2 class="section-title" data-i18n="benefits_title">Why Millions Choose Simple Calculator</h2>
    <p class="section-subtitle">Engineered from the ground up for speed, mathematical rigor, and user privacy</p>
  </div>

  <div class="benefits-grid">
    {benefits.map((b) => (
      <div class="benefit-card">
        <div class="benefit-icon">{b.icon}</div>
        <h3 class="benefit-title">{b.title}</h3>
        <p class="benefit-desc">{b.desc}</p>
      </div>
    ))}
  </div>
</section>
