---
// Calculator component
---

<!-- Main Calculator Application Workspace (Left: Keypad | Right: Answer Station) -->
<main class="calculator-app">
  <div class="calculator-workspace" id="calculator">
    
    <!-- LEFT SIDE: Keypad, Controls & Expression -->
    <div class="calc-left-column">
      <div class="calculator-card">
        <!-- Header / Top Controls -->
        <header class="calc-header">
          <div class="brand">
            <div class="brand-logo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="3"></rect>
                <line x1="8" y1="6" x2="16" y2="6"></line>
                <line x1="16" y1="14" x2="16" y2="14"></line>
                <line x1="12" y1="14" x2="12" y2="14"></line>
                <line x1="8" y1="14" x2="8" y2="14"></line>
                <line x1="16" y1="18" x2="16" y2="18"></line>
                <line x1="12" y1="18" x2="12" y2="18"></line>
                <line x1="8" y1="18" x2="8" y2="18"></line>
                <line x1="8" y1="10" x2="8" y2="10"></line>
                <line x1="12" y1="10" x2="12" y2="10"></line>
                <line x1="16" y1="10" x2="16" y2="10"></line>
              </svg>
            </div>
            <h1 class="brand-title" data-i18n="brand_title">Simple Calculator</h1>
          </div>

          <div class="header-controls">
            <!-- Light / Dark Theme Toggle Button -->
            <button type="button" class="icon-btn" id="btn-theme-toggle" title="Toggle Light / Dark Mode" data-i18n-title="toggle_theme" aria-label="Toggle theme">
              <!-- Sun Icon (shown in dark mode) -->
              <svg id="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <!-- Moon Icon (shown in light mode) -->
              <svg id="theme-icon-moon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>

            <!-- Sound Toggle -->
            <button type="button" class="icon-btn" id="btn-sound-toggle" title="Toggle Sound Feedback" data-i18n-title="toggle_sound" aria-label="Toggle sound">
              <svg id="sound-icon-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              </svg>
              <svg id="sound-icon-off" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <line x1="23" y1="9" x2="17" y2="15"></line>
                <line x1="17" y1="9" x2="23" y2="15"></line>
              </svg>
            </button>

            <!-- SCI Toggle -->
            <button type="button" class="icon-btn" id="btn-mode-toggle" title="Toggle Scientific Mode" data-i18n-title="toggle_sci" aria-label="Toggle scientific mode">
              <span class="mode-badge">SCI</span>
            </button>

            <!-- History Toggle (Mobile View) -->
            <button type="button" class="icon-btn btn-mobile-history-toggle" id="btn-history-toggle" title="Toggle History Drawer" data-i18n-title="toggle_history" aria-label="Toggle history">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </button>
          </div>
        </header>

        <!-- Compact Keypad Input Ribbon -->
        <div class="calc-input-ribbon">
          <span class="input-ribbon-tag">Expression</span>
          <span class="input-ribbon-value" id="calc-input-preview">Ready</span>
        </div>

        <!-- Keypad Grid -->
        <div class="calc-body">
          <!-- Scientific Panel (Collapsible) -->
          <div class="scientific-panel" id="scientific-panel">
            <!-- Theta (θ) Angle & Real-time Value Bar ("θ का मान") -->
            <div class="sci-theta-box" id="sci-theta-box">
              <div class="sci-theta-header">
                <div class="sci-theta-label-group">
                  <span class="sci-theta-symbol">θ</span>
                  <span class="sci-theta-title">Angle (θ):</span>
                  <div class="sci-theta-input-wrap">
                    <input type="number" id="sci-theta-input" value="30" step="any" placeholder="30" aria-label="Theta angle value" />
                    <span class="sci-theta-unit-label" id="sci-theta-unit-label">°</span>
                  </div>
                </div>
                
                <div class="sci-theta-presets">
                  <button type="button" class="sci-preset-btn" data-angle="0">0°</button>
                  <button type="button" class="sci-preset-btn active" data-angle="30">30°</button>
                  <button type="button" class="sci-preset-btn" data-angle="45">45°</button>
                  <button type="button" class="sci-preset-btn" data-angle="60">60°</button>
                  <button type="button" class="sci-preset-btn" data-angle="90">90°</button>
                  <button type="button" class="sci-preset-btn" data-angle="180">180°</button>
                </div>
              </div>

              <!-- Live Theta Maan (Values) Quick Cards -->
              <div class="sci-theta-values">
                <button type="button" class="sci-theta-val-card" data-trig-fn="sin" id="sci-val-sin" title="Click to insert sin(θ) value">
                  <span class="sci-val-name">sin θ</span>
                  <span class="sci-val-exact" id="sci-sin-exact">1/2</span>
                  <span class="sci-val-dec" id="sci-sin-dec">0.5</span>
                </button>
                <button type="button" class="sci-theta-val-card" data-trig-fn="cos" id="sci-val-cos" title="Click to insert cos(θ) value">
                  <span class="sci-val-name">cos θ</span>
                  <span class="sci-val-exact" id="sci-cos-exact">√3/2</span>
                  <span class="sci-val-dec" id="sci-cos-dec">0.866</span>
                </button>
                <button type="button" class="sci-theta-val-card" data-trig-fn="tan" id="sci-val-tan" title="Click to insert tan(θ) value">
                  <span class="sci-val-name">tan θ</span>
                  <span class="sci-val-exact" id="sci-tan-exact">1/√3</span>
                  <span class="sci-val-dec" id="sci-tan-dec">0.577</span>
                </button>
                <button type="button" class="sci-theta-val-card" data-trig-fn="cot" id="sci-val-cot" title="Click to insert cot(θ) value">
                  <span class="sci-val-name">cot θ</span>
                  <span class="sci-val-exact" id="sci-cot-exact">√3</span>
                  <span class="sci-val-dec" id="sci-cot-dec">1.732</span>
                </button>
              </div>
            </div>

            <!-- Scientific Buttons Grid (4x4) -->
            <div class="sci-buttons-grid">
              <!-- Row 1: Trigonometric Functions & Theta -->
              <button type="button" class="calc-btn btn-func" data-action="sin" title="Sine">sin</button>
              <button type="button" class="calc-btn btn-func" data-action="cos" title="Cosine">cos</button>
              <button type="button" class="calc-btn btn-func" data-action="tan" title="Tangent">tan</button>
              <button type="button" class="calc-btn btn-func btn-theta-key" data-action="theta" title="Theta (θ) Variable / Angle">θ</button>

              <!-- Row 2: Logs & Powers -->
              <button type="button" class="calc-btn btn-func" data-action="ln" title="Natural Logarithm">ln</button>
              <button type="button" class="calc-btn btn-func" data-action="log" title="Base-10 Logarithm">log</button>
              <button type="button" class="calc-btn btn-func" data-action="square" title="Square (x²)">x²</button>
              <button type="button" class="calc-btn btn-func" data-action="power" title="Power (xʸ)">xʸ</button>

              <!-- Row 3: Roots, Factorial, Constants -->
              <button type="button" class="calc-btn btn-func" data-action="sqrt" title="Square Root">√</button>
              <button type="button" class="calc-btn btn-func" data-action="fact" title="Factorial (n!)">n!</button>
              <button type="button" class="calc-btn btn-func" data-action="pi" title="Pi (π)">π</button>
              <button type="button" class="calc-btn btn-func" data-action="e" title="Euler's Number (e)">e</button>

              <!-- Row 4: Angle Mode & Extended Trig Functions -->
              <button type="button" class="calc-btn btn-func" data-action="deg-rad" id="deg-rad-btn" title="Toggle Radians / Degrees">RAD</button>
              <button type="button" class="calc-btn btn-func" data-action="cot" title="Cotangent">cot</button>
              <button type="button" class="calc-btn btn-func" data-action="sec" title="Secant">sec</button>
              <button type="button" class="calc-btn btn-func" data-action="csc" title="Cosecant">csc</button>
            </div>
          </div>

          <!-- Standard Keypad Panel -->
          <div class="standard-panel">
            <!-- Row 1 -->
            <button type="button" class="calc-btn btn-action" data-action="clear" id="btn-clear" aria-label="All Clear">AC</button>
            <button type="button" class="calc-btn btn-action" data-action="backspace" id="btn-backspace" aria-label="Delete">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"></path>
                <line x1="18" y1="9" x2="12" y2="15"></line>
                <line x1="12" y1="9" x2="18" y2="15"></line>
              </svg>
            </button>
            <button type="button" class="calc-btn btn-action" data-action="parenthesis" aria-label="Parentheses">( )</button>
            <button type="button" class="calc-btn btn-operator" data-action="divide" aria-label="Divide">÷</button>

            <!-- Row 2 -->
            <button type="button" class="calc-btn btn-number" data-number="7">7</button>
            <button type="button" class="calc-btn btn-number" data-number="8">8</button>
            <button type="button" class="calc-btn btn-number" data-number="9">9</button>
            <button type="button" class="calc-btn btn-operator" data-action="multiply" aria-label="Multiply">×</button>

            <!-- Row 3 -->
            <button type="button" class="calc-btn btn-number" data-number="4">4</button>
            <button type="button" class="calc-btn btn-number" data-number="5">5</button>
            <button type="button" class="calc-btn btn-number" data-number="6">6</button>
            <button type="button" class="calc-btn btn-operator" data-action="subtract" aria-label="Minus">−</button>

            <!-- Row 4 -->
            <button type="button" class="calc-btn btn-number" data-number="1">1</button>
            <button type="button" class="calc-btn btn-number" data-number="2">2</button>
            <button type="button" class="calc-btn btn-number" data-number="3">3</button>
            <button type="button" class="calc-btn btn-operator" data-action="add" aria-label="Plus">+</button>

            <!-- Row 5 -->
            <button type="button" class="calc-btn btn-action" data-action="negate" aria-label="Toggle Sign">±</button>
            <button type="button" class="calc-btn btn-number" data-number="0">0</button>
            <button type="button" class="calc-btn btn-number" data-action="decimal">.</button>
            <button type="button" class="calc-btn btn-equals" data-action="calculate" aria-label="Equals">=</button>
          </div>
        </div>

        <!-- Keyboard Hint Footer -->
        <footer class="calc-footer">
          <span class="shortcut-tip"><kbd>Enter</kbd> = <kbd>Esc</kbd> AC <kbd>Bksp</kbd> ⌫</span>
        </footer>
      </div>
    </div>

    <!-- RIGHT SIDE: Dedicated Live Answer Screen, Status & History Station -->
    <div class="calc-right-column">
      <div class="calc-answer-station">
        
        <!-- Answer Station Header -->
        <div class="station-header">
          <div class="station-badge">
            <span class="station-dot"></span>
            <span>Live Calculation Output</span>
          </div>
          <div class="station-pills">
            <span class="station-pill" id="station-mode-tag">DEG Mode</span>
            <span class="station-pill status-ready">IEEE 754</span>
          </div>
        </div>

        <!-- Prominent Live Display Screen -->
        <section class="calc-display-wrapper">
          <div class="calc-display">
            <div class="display-expression-row">
              <span class="display-expression" id="display-expression" title="Expression"></span>
            </div>
            <div class="display-main-row">
              <button type="button" class="copy-result-btn" id="btn-copy" title="Copy result to clipboard" aria-label="Copy result">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span class="copy-tooltip" id="copy-tooltip">Copied!</span>
              </button>
              <span class="display-result" id="display-result" aria-live="polite">0</span>
            </div>
          </div>
        </section>

        <!-- Quick Output Actions Bar -->
        <div class="answer-actions-bar">
          <button type="button" class="ans-action-btn" id="btn-action-copy" title="Copy active result">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Copy Answer</span>
          </button>
          <button type="button" class="ans-action-btn" id="btn-action-clear" title="Clear Calculation">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span>Clear (AC)</span>
          </button>
        </div>

        <!-- Live Calculation Tape & History Drawer -->
        <aside class="history-drawer" id="history-drawer" aria-label="Calculation History">
          <div class="history-header">
            <div class="history-title-wrap">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span data-i18n="history_title">Calculation Tape & History</span>
            </div>
            <button type="button" class="btn-clear-history" id="btn-clear-history" title="Clear all history" data-i18n="clear_history">Clear Tape</button>
          </div>
          <div class="history-list" id="history-list">
            <div class="history-empty" data-i18n="no_history">No calculation history yet</div>
          </div>
        </aside>

      </div>
    </div>

  </div>
</main>

<script>
  import '../scripts/i18n.js';
  import '../scripts/calculator.js';
</script>
