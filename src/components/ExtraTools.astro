---
// Extra utility tools component with rich in-tool contextual linking
---

<section class="extra-tools-section" id="tools-section">
  <div class="section-header">
    <div class="section-badge">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
      </svg>
      <span data-i18n="extra_tools_badge">Quick Math & Finance Tools</span>
    </div>
    <h2 class="section-title" data-i18n="extra_tools_title">Helpful Calculation Tools & Theta (&theta;) Table</h2>
    <p class="section-subtitle" data-i18n="extra_tools_subtitle">Select any tool below to calculate instantly with precision</p>
  </div>

  <!-- Tools Tabs Navigation -->
  <div class="tools-tabs">
    <button type="button" class="tool-tab-btn active" data-target="tool-trig">
      <span class="tab-theta-symbol">&theta;</span>
      <span data-i18n="tab_trig">Trig &theta; Values</span>
    </button>

    <button type="button" class="tool-tab-btn" data-target="tool-percentage">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="19" y1="5" x2="5" y2="19"></line>
        <circle cx="6.5" cy="6.5" r="2.5"></circle>
        <circle cx="17.5" cy="17.5" r="2.5"></circle>
      </svg>
      <span data-i18n="tab_percentage">Percentage</span>
    </button>

    <button type="button" class="tool-tab-btn" data-target="tool-discount">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
      </svg>
      <span data-i18n="tab_discount">Discount / GST</span>
    </button>

    <button type="button" class="tool-tab-btn" data-target="tool-unit">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      </svg>
      <span data-i18n="tab_unit">Unit Converter</span>
    </button>

    <button type="button" class="tool-tab-btn" data-target="tool-bmi">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <span data-i18n="tab_bmi">BMI Health</span>
    </button>

    <button type="button" class="tool-tab-btn" data-target="tool-age">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
      </svg>
      <span data-i18n="tab_age">Age Calculator</span>
    </button>
  </div>

  <!-- Tool Content Panels -->
  <div class="tools-content-wrapper">
    <!-- 0. Trigonometric Theta (θ) Values Finder (NEW) -->
    <div class="tool-panel active" id="tool-trig">
      <div class="tool-card">
        <div class="tool-header-row">
          <div class="tool-title-wrap">
            <span class="tool-theta-badge">&theta;</span>
            <h3 class="tool-heading">Trigonometric &theta; (Theta) Values & Ratio Finder</h3>
          </div>
          <a href="#guides-section" class="tool-guide-badge" title="View Full Trigonometric Identities">Trig Formulas &rarr;</a>
        </div>

        <p class="tool-instruction">
          Enter any angle <strong>&theta;</strong> or tap a standard angle to get exact and decimal values for all 6 trigonometric ratios:
        </p>

        <!-- Angle Input Row -->
        <div class="tool-form-row">
          <div class="input-group">
            <label for="trig-angle">Angle (&theta;)</label>
            <div class="input-with-suffix">
              <input type="number" id="trig-angle" placeholder="e.g. 30" value="30" step="any" />
              <span class="suffix" id="trig-unit-label">&deg;</span>
            </div>
          </div>

          <div class="input-group">
            <label for="trig-unit">Unit Mode</label>
            <select id="trig-unit">
              <option value="deg" selected>Degrees (&deg;)</option>
              <option value="rad">Radians (rad)</option>
            </select>
          </div>
        </div>

        <!-- Quick Standard Angle Buttons -->
        <div class="theta-presets-wrap">
          <span class="preset-label">Standard Angles (&theta;):</span>
          <div class="theta-presets-list">
            <button type="button" class="theta-preset-btn" data-angle="0">0&deg;</button>
            <button type="button" class="theta-preset-btn active" data-angle="30">30&deg; (&pi;/6)</button>
            <button type="button" class="theta-preset-btn" data-angle="45">45&deg; (&pi;/4)</button>
            <button type="button" class="theta-preset-btn" data-angle="60">60&deg; (&pi;/3)</button>
            <button type="button" class="theta-preset-btn" data-angle="90">90&deg; (&pi;/2)</button>
            <button type="button" class="theta-preset-btn" data-angle="180">180&deg; (&pi;)</button>
            <button type="button" class="theta-preset-btn" data-angle="270">270&deg; (3&pi;/2)</button>
            <button type="button" class="theta-preset-btn" data-angle="360">360&deg; (2&pi;)</button>
          </div>
        </div>

        <!-- 6 Trigonometric Ratios Grid -->
        <div class="trig-ratios-grid">
          <!-- sin θ -->
          <div class="trig-ratio-box highlight">
            <div class="ratio-header">
              <span class="ratio-name">sin(&theta;)</span>
              <span class="ratio-type">Primary</span>
            </div>
            <div class="ratio-exact" id="ratio-sin-exact">1/2</div>
            <div class="ratio-dec" id="ratio-sin-dec">&approx; 0.5000</div>
          </div>

          <!-- cos θ -->
          <div class="trig-ratio-box highlight">
            <div class="ratio-header">
              <span class="ratio-name">cos(&theta;)</span>
              <span class="ratio-type">Primary</span>
            </div>
            <div class="ratio-exact" id="ratio-cos-exact">&radic;3 / 2</div>
            <div class="ratio-dec" id="ratio-cos-dec">&approx; 0.8660</div>
          </div>

          <!-- tan θ -->
          <div class="trig-ratio-box highlight">
            <div class="ratio-header">
              <span class="ratio-name">tan(&theta;)</span>
              <span class="ratio-type">Primary</span>
            </div>
            <div class="ratio-exact" id="ratio-tan-exact">1 / &radic;3</div>
            <div class="ratio-dec" id="ratio-tan-dec">&approx; 0.5774</div>
          </div>

          <!-- cosec θ (csc) -->
          <div class="trig-ratio-box">
            <div class="ratio-header">
              <span class="ratio-name">cosec(&theta;)</span>
              <span class="ratio-type">1 / sin &theta;</span>
            </div>
            <div class="ratio-exact" id="ratio-csc-exact">2</div>
            <div class="ratio-dec" id="ratio-csc-dec">&approx; 2.0000</div>
          </div>

          <!-- sec θ -->
          <div class="trig-ratio-box">
            <div class="ratio-header">
              <span class="ratio-name">sec(&theta;)</span>
              <span class="ratio-type">1 / cos &theta;</span>
            </div>
            <div class="ratio-exact" id="ratio-sec-exact">2 / &radic;3</div>
            <div class="ratio-dec" id="ratio-sec-dec">&approx; 1.1547</div>
          </div>

          <!-- cot θ -->
          <div class="trig-ratio-box">
            <div class="ratio-header">
              <span class="ratio-name">cot(&theta;)</span>
              <span class="ratio-type">1 / tan &theta;</span>
            </div>
            <div class="ratio-exact" id="ratio-cot-exact">&radic;3</div>
            <div class="ratio-dec" id="ratio-cot-dec">&approx; 1.7321</div>
          </div>
        </div>

        <div class="tool-context-footer">
          <span>Explore:</span>
          <a href="#calculator" class="tool-ctx-tag">Main Scientific Calc</a>
          <a href="#guides-section" class="tool-ctx-tag">Trig Identities Table</a>
          <a href="https://mathworld.wolfram.com/TrigonometricFunctions.html" target="_blank" rel="noopener noreferrer" class="tool-ctx-ext">Wolfram Trig Functions &#8599;</a>
        </div>
      </div>
    </div>

    <!-- 1. Percentage Calculator -->
    <div class="tool-panel" id="tool-percentage">
      <div class="tool-card">
        <div class="tool-header-row">
          <h3 class="tool-heading">Percentage Calculator</h3>
          <a href="#guides-section" class="tool-guide-badge" title="View Percentage Formula Guide">Formula Guide &rarr;</a>
        </div>
        <div class="tool-form-row">
          <div class="input-group">
            <label for="perc-val">What is</label>
            <div class="input-with-suffix">
              <input type="number" id="perc-val" placeholder="e.g. 20" value="20" />
              <span class="suffix">%</span>
            </div>
          </div>
          <div class="input-group">
            <label for="perc-total">of Number</label>
            <input type="number" id="perc-total" placeholder="e.g. 500" value="500" />
          </div>
        </div>
        <div class="tool-result-box">
          <span class="result-label">Result:</span>
          <span class="result-value" id="perc-result">100</span>
        </div>
        <div class="tool-context-footer">
          <span>Related:</span>
          <a href="#tool-discount" class="tool-ctx-tag">Discount Calculator</a>
          <a href="#calculator" class="tool-ctx-tag">Main Calculator (%)</a>
          <a href="https://en.wikipedia.org/wiki/Percentage" target="_blank" rel="noopener noreferrer" class="tool-ctx-ext">Wikipedia Percentage &#8599;</a>
        </div>
      </div>
    </div>

    <!-- 2. Discount & GST Calculator -->
    <div class="tool-panel" id="tool-discount">
      <div class="tool-card">
        <div class="tool-header-row">
          <h3 class="tool-heading">Discount & GST Calculator</h3>
          <a href="#guides-section" class="tool-guide-badge" title="View GST & Discount Formula Guide">Formula Guide &rarr;</a>
        </div>
        <div class="tool-form-row">
          <div class="input-group">
            <label for="disc-price">Original Price</label>
            <input type="number" id="disc-price" placeholder="1000" value="1000" />
          </div>
          <div class="input-group">
            <label for="disc-percent">Discount (%)</label>
            <div class="input-with-suffix">
              <input type="number" id="disc-percent" placeholder="15" value="15" />
              <span class="suffix">%</span>
            </div>
          </div>
          <div class="input-group">
            <label for="disc-gst">GST / Tax (%)</label>
            <div class="input-with-suffix">
              <input type="number" id="disc-gst" placeholder="18" value="18" />
              <span class="suffix">%</span>
            </div>
          </div>
        </div>
        <div class="tool-results-grid">
          <div class="tool-result-box">
            <span class="result-label">Discount Amount:</span>
            <span class="result-value" id="disc-saved">₹150</span>
          </div>
          <div class="tool-result-box highlight">
            <span class="result-label">Final Payable Price:</span>
            <span class="result-value" id="disc-final">₹1,003</span>
          </div>
        </div>
        <div class="tool-context-footer">
          <span>Related:</span>
          <a href="#tool-percentage" class="tool-ctx-tag">Percentage Tool</a>
          <a href="https://www.cbic.gov.in/" target="_blank" rel="noopener noreferrer" class="tool-ctx-ext">Official CBIC GST Slabs &#8599;</a>
        </div>
      </div>
    </div>

    <!-- 3. Unit Converter -->
    <div class="tool-panel" id="tool-unit">
      <div class="tool-card">
        <div class="tool-header-row">
          <h3 class="tool-heading">Universal Unit Converter</h3>
          <a href="https://physics.nist.gov/cuu/Units/" target="_blank" rel="noopener noreferrer" class="tool-guide-badge">NIST SI Standards &#8599;</a>
        </div>
        <div class="tool-form-row">
          <div class="input-group">
            <label for="unit-category">Type</label>
            <select id="unit-category">
              <option value="length">Length</option>
              <option value="weight">Weight</option>
              <option value="temp">Temperature</option>
            </select>
          </div>
          <div class="input-group">
            <label for="unit-from-val">From</label>
            <input type="number" id="unit-from-val" value="1" />
            <select id="unit-from-type" class="mt-1">
              <option value="m">Meters (m)</option>
              <option value="km">Kilometers (km)</option>
              <option value="cm">Centimeters (cm)</option>
              <option value="ft">Feet (ft)</option>
              <option value="inch">Inches (in)</option>
              <option value="mile">Miles (mi)</option>
            </select>
          </div>
          <div class="input-group">
            <label for="unit-to-type">To</label>
            <select id="unit-to-type">
              <option value="cm">Centimeters (cm)</option>
              <option value="m">Meters (m)</option>
              <option value="km">Kilometers (km)</option>
              <option value="ft">Feet (ft)</option>
              <option value="inch">Inches (in)</option>
              <option value="mile">Miles (mi)</option>
            </select>
          </div>
        </div>
        <div class="tool-result-box highlight">
          <span class="result-label">Converted Value:</span>
          <span class="result-value" id="unit-result">100 cm</span>
        </div>
        <div class="tool-context-footer">
          <span>Standards:</span>
          <a href="https://www.bipm.org/en/measurement-units/" target="_blank" rel="noopener noreferrer" class="tool-ctx-ext">BIPM Metric Authority &#8599;</a>
          <a href="#calculator" class="tool-ctx-tag">Main Scientific Calc</a>
        </div>
      </div>
    </div>

    <!-- 4. BMI Calculator -->
    <div class="tool-panel" id="tool-bmi">
      <div class="tool-card">
        <div class="tool-header-row">
          <h3 class="tool-heading">Body Mass Index (BMI) Calculator</h3>
          <a href="#guides-section" class="tool-guide-badge">WHO Scale &rarr;</a>
        </div>
        <div class="tool-form-row">
          <div class="input-group">
            <label for="bmi-weight">Weight (kg)</label>
            <input type="number" id="bmi-weight" placeholder="70" value="70" />
          </div>
          <div class="input-group">
            <label for="bmi-height">Height (cm)</label>
            <input type="number" id="bmi-height" placeholder="175" value="175" />
          </div>
        </div>
        <div class="tool-results-grid">
          <div class="tool-result-box">
            <span class="result-label">Your BMI Score:</span>
            <span class="result-value" id="bmi-score">22.9</span>
          </div>
          <div class="tool-result-box highlight">
            <span class="result-label">Category:</span>
            <span class="result-value" id="bmi-category" style="color: #22c55e;">Normal Weight</span>
          </div>
        </div>
        <div class="tool-context-footer">
          <span>Official Data:</span>
          <a href="https://www.who.int/data/gho/data/themes/theme-details/GHO/body-mass-index-(bmi)" target="_blank" rel="noopener noreferrer" class="tool-ctx-ext">WHO BMI Classification &#8599;</a>
          <a href="https://www.cdc.gov/healthyweight/assessing/bmi/index.html" target="_blank" rel="noopener noreferrer" class="tool-ctx-ext">CDC Health Guidelines &#8599;</a>
        </div>
      </div>
    </div>

    <!-- 5. Age Calculator -->
    <div class="tool-panel" id="tool-age">
      <div class="tool-card">
        <div class="tool-header-row">
          <h3 class="tool-heading">Age & Date of Birth Calculator</h3>
          <a href="#faq-section" class="tool-guide-badge">FAQ &rarr;</a>
        </div>
        <div class="tool-form-row">
          <div class="input-group">
            <label for="age-dob">Date of Birth</label>
            <input type="date" id="age-dob" value="2000-01-01" />
          </div>
        </div>
        <div class="tool-results-grid">
          <div class="tool-result-box highlight">
            <span class="result-label">Your Exact Age:</span>
            <span class="result-value" id="age-result">-- Years, -- Months</span>
          </div>
          <div class="tool-result-box">
            <span class="result-label">Next Birthday In:</span>
            <span class="result-value" id="age-next-bday">-- Days</span>
          </div>
        </div>
        <div class="tool-context-footer">
          <span>Explore:</span>
          <a href="#calculator" class="tool-ctx-tag">Standard Calc</a>
          <a href="https://en.wikipedia.org/wiki/Gregorian_calendar" target="_blank" rel="noopener noreferrer" class="tool-ctx-ext">Gregorian Calendar Wiki &#8599;</a>
        </div>
      </div>
    </div>
  </div>
</section>
